+--- @param bufnr integer
+--- @return integer
+function M.signwidth(bufnr)
+  local signs = api.nvim_buf_get_extmarks(bufnr, -1, 0, -1, { type = 'sign', limit = 1 })
+  return #signs > 0 and 2 or 0
+end
+
 --- Round to the nearest integer.
 --- WARN: .5 rounds to the right on the number line, including for negatives
 --- (which would not result in rounding up in magnitude).
