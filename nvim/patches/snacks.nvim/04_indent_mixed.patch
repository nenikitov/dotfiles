+---@param scope snacks.indent.Scope
+---@param state snacks.indent.State
+---@return number level, number? parent
+scope_level = function(scope, state)
+  local indent = scope.indent or 0
+  local from, to = bounds(scope, state)
+  for l = from, to do
+    local cols = state.cols[l]
+    if cols and not state.blanks[l] and (state.indents[l] or 0) >= indent then
+      local level, parent = 1, nil ---@type number, number?
+      for _, c in ipairs(cols) do
+        if c < indent then
+          level, parent = level + 1, c
+        end
+      end
+      return level, parent
+    end
+  end
+  local parent = indent - state.shiftwidth
+  return math.floor(indent / state.shiftwidth) + 1, parent >= 0 and parent or nil
+end
