+---@param state snacks.indent.State
+---@param l number
+---@return table<number, boolean>?
+local function get_tabs(state, l)
+  if l < 1 then
+    return nil
+  end
+  if not state.tabs[l] then
+    local ws = vim.api.nvim_buf_get_lines(state.buf, l - 1, l, false)[1]:match("^%s*")
+    local tabs, vcol = {}, 0
+    for i = 1, #ws do
+      local tab = ws:sub(i, i) == "\t"
+      local width = tab and state.tabstop - vcol % state.tabstop or 1
+      if tab then
+        for c = vcol, vcol + width - 1 do
+          tabs[c] = true
+        end
+      end
+      vcol = vcol + width
+    end
+    state.tabs[l] = tabs
+  end
+  return state.tabs[l]
+end
